{
    "name": "zk-tower-circuits",
    "private": true,
    "description": "Demo circuits, trusted setup and proving scripts for zk-tower",
    "scripts": {
        "compile:age-over": "mkdir -p compiled && circom --r1cs --wasm --sym -l node_modules -o compiled/ age_over.circom",
        "witness:valid-cred-and-valid-age": "node compiled/age_over_js/generate_witness.js compiled/age_over_js/age_over.wasm ./inputs/1_valid_credentials_and_valid_age.json compiled/witness.wtns",
        "witness:valid-cred-and-invalid-age": "node compiled/age_over_js/generate_witness.js compiled/age_over_js/age_over.wasm ./inputs/2_valid_credentials_but_invalid_age.json compiled/witness.wtns",
        "witness:invalid-cred-and-valid-age": "node compiled/age_over_js/generate_witness.js compiled/age_over_js/age_over.wasm ./inputs/3_invalid_credential_and_valid_age.json compiled/witness.wtns",
        "witness:invalid-cred-and-invalid-age": "node compiled/age_over_js/generate_witness.js compiled/age_over_js/age_over.wasm ./inputs/4_invalid_credential_and_invalid_age.json compiled/witness.wtns",
        "issuer:init": "node scripts/issueCredential.js init",
        "issuer:alice": "node scripts/issueCredential.js issue 20050615 compiled/alice_credential.json",
        "witness:alice": "jq '. + {currentDate: \"20261119\"}' compiled/alice_credential.json > compiled/alice_input.json && node compiled/age_over_js/generate_witness.js compiled/age_over_js/age_over.wasm compiled/alice_input.json compiled/witness.wtns && echo 'witness OK'",
        "build:age-over": "yarn compile:age-over && node scripts/buildAgeOver.js"
    },
    "devDependencies": {
        "circomlib": "^2.0.5",
        "circomlibjs": "^0.1.7",
        "snarkjs": "^0.7.6"
    }
}
